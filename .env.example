# KickCast backend .env - copy to .env. The site works with NO keys at all (openfootball,
# football-data.co.uk, StatsBomb, and the international results/goalscorers CSVs are all
# free and keyless). Every variable below unlocks something extra and is optional.

# Path to the SQLite database. Optional - defaults to data/kickcast.db.
# KICKCAST_DB_PATH=data/kickcast.db
